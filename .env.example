# Copy to .env (or .env.local) and fill in. Never commit the filled-in file.

# --- Neon Postgres ---------------------------------------------------------
# Pooled connection (used by the app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection (used by Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Clerk -----------------------------------------------------------------
# From dashboard.clerk.com -> API keys. Both are required, even in development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- Email (Resend) ---------------------------------------------------------
# Without RESEND_API_KEY, emails are printed to the server console instead of sent.
RESEND_API_KEY="re_..."
# Must be on a domain verified in Resend (e.g. fortestrength.org)
EMAIL_FROM="Forte Strength Systems <noreply@fortestrength.org>"
# Who gets notified about new coaching applications
APPLICATION_NOTIFY_EMAIL="Tym.26911@gmail.com"

# --- Site ------------------------------------------------------------------
# Used for links in emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics -------------------------------------------------------------
# Full IPs and visit rows are removed after this many days (1–3650; default 90).
ANALYTICS_RETENTION_DAYS="90"
# IANA timezone for dashboard charts and dates.
ANALYTICS_TIMEZONE="America/New_York"
# Optional: use a geo-IP provider when hosting headers lack location data.
# The provider receives visitor IPs. Leave blank to use hosting headers only.
# Example: https://ipapi.co/{ip}/json/
ANALYTICS_GEOIP_ENDPOINT=""
# Random secret of at least 16 characters for the daily retention job.
# Set in production; Vercel passes it as Authorization: Bearer <secret>.
CRON_SECRET=""
