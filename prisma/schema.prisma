// Forte Strength Systems data model.
// Connection URLs live in prisma.config.ts (CLI) and src/server/db.ts (app).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Website accounts (not coaching clients)
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum Sex {
  MALE
  FEMALE
}

enum WeightUnit {
  LB
  KG
}

enum HeightUnit {
  FT_IN
  CM
}

enum Intensity {
  VERY_LIGHT
  LIGHT
  MODERATE
  HARD
  VERY_HARD
}

/// A website account, created from Clerk the first time the person is seen.
/// Set `role` to ADMIN (e.g. in Prisma Studio) to unlock the admin panel.
model User {
  id                  String     @id @default(cuid())
  clerkId             String     @unique
  email               String
  firstName           String?
  lastName            String?
  imageUrl            String?
  role                Role       @default(USER)
  onboardedAt         DateTime?
  onboardingSkippedAt DateTime?
  /// Set when the coach marks the account as a coaching client; null otherwise.
  clientSince         DateTime?
  /// How they read gym weights (plates, dumbbells, machines). Deliberately separate
  /// from `Profile.weightUnit`: plenty of lifters compete in kg but train in lb.
  /// Lives here rather than on Profile so someone who skipped onboarding still has one.
  liftUnit            WeightUnit @default(LB)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  profile             Profile?
  exercises           Exercise[]
  prSeries            PrSeries[]
  prEntries           PrEntry[]

  @@index([email])
  @@index([createdAt])
  @@index([clientSince])
}

/// Body and activity stats used to autofill the tools.
/// Weight and height keep the user's preferred units so autofill shows what they entered.
model Profile {
  userId          String     @id
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate       DateTime   @db.Date
  sex             Sex
  weight          Float
  weightUnit      WeightUnit
  heightCm        Float
  heightUnit      HeightUnit
  bodyFatPercent  Float
  stepsPerDay     Int
  sessionsPerWeek Int
  /// Null when the user trains 0 sessions a week.
  intensity       Intensity?
  updatedAt       DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Coaching applications (separate from website accounts)
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  UNPROCESSED
  PROCESSED
}

enum CoachingNeed {
  COMPETITIVE_POWERLIFTING
  RECREATIONAL_POWERLIFTING
  WEIGHT_LOSS_RECOMP
  OTHER
}

enum CurrentCoach {
  YES_LOOKING_FOR_BETTER
  NO_BUT_HAVE_BEFORE
  NO_NEVER
}

enum FinancePriority {
  MOST_COST_EFFECTIVE
  SOLID_AFFORDABLE
  PREMIUM
}

enum Readiness {
  READY_NOW
  NEED_TO_PREPARE
  NOT_SURE
}

model Application {
  id          String            @id @default(cuid())
  status      ApplicationStatus @default(UNPROCESSED)
  processedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // About you
  fullName  String
  age       Int
  email     String
  phone     String
  location  String
  instagram String

  // Your lifting
  primaryNeed         CoachingNeed
  primaryNeedOther    String?
  squat               Float
  bench               Float
  deadlift            Float
  liftUnit            WeightUnit
  liftsAreCompetition Boolean
  weightClass         String

  // Your story
  goals                 String @db.Text
  challenges            String @db.Text
  overthinker           Int
  injuries              String @db.Text
  nutritionRestrictions String @db.Text
  programming           String @db.Text

  // Commitment
  currentCoach    CurrentCoach
  whyForte        String          @db.Text
  commitment      String
  financePriority FinancePriority
  readiness       Readiness

  @@index([status, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Coach profile (editable in the admin panel, shown site-wide)
// ---------------------------------------------------------------------------

/// Singleton row (id = "coach").
model CoachProfile {
  id              String   @id @default("coach")
  name            String
  title           String
  credentials     String
  yearsExperience Int
  bio             String   @db.Text
  worldRecords    Int
  americanRecords Int
  stateRecords    Int
  homeBase        String
  reach           String[]
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Website analytics (anonymous visitors, deliberately not tied to User)
// ---------------------------------------------------------------------------

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

/// One page view. Written by the asynchronous browser request to `POST /api/collect`.
///
/// `ipAddress` is personal data: it is retained for `ANALYTICS_RETENTION_DAYS`
/// (default 90) and then purged by automatic retention cleanup. `userId` is a
/// loose reference, not a relation — traffic history outlives the account.
model PageView {
  id        String   @id @default(cuid())
  /// `timestamptz`, not a naive `timestamp`: this is an instant, and every
  /// analytics query compares it against a JS `Date` and converts it into the
  /// display timezone. A naive column makes both of those silently wrong.
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// First-party cookie, stable across sessions. Not an account id.
  visitorId String
  /// Rotates after 30 minutes idle.
  sessionId String
  userId    String?

  path         String
  title        String?
  referrer     String? @db.Text
  /// Host only, so "google.com" groups regardless of query string. Null = direct.
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?

  ipAddress String?
  /// ISO 3166-1 alpha-2.
  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  timezone  String?

  userAgent String?    @db.Text
  browser   String?
  os        String?
  device    DeviceType @default(UNKNOWN)
  screenW   Int?
  screenH   Int?
  viewportW Int?
  viewportH Int?
  language  String?

  /// Filled in by a `sendBeacon` when the page is hidden, so it can stay null.
  durationMs Int?
  /// First view of its session, which is what makes bounce rate computable.
  isEntry    Boolean @default(false)
  isBot      Boolean @default(false)

  @@index([createdAt])
  @@index([isBot, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
  @@index([country, createdAt])
  @@index([referrerHost, createdAt])
}

// ---------------------------------------------------------------------------
// PR tracker (coaching clients and admins)
// ---------------------------------------------------------------------------

enum PrKind {
  ONE_REP_MAX
  REP
  VOLUME
}

/// A movement someone tracks PRs for. `slug` is the normalised name, so
/// "Bench Press", "bench  press" and "BENCH-PRESS" can never coexist for one user.
model Exercise {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// As picked from the catalogue or typed, for display.
  name      String
  /// Normalised form of `name`, for identity. See `slugify` in the feature's lib.
  slug      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  series    PrSeries[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
}

/// One progression: "bench press 1RM", "bench press 2-rep", "bench press 3x5 volume".
/// The unique constraint is what makes a duplicate PR type structurally impossible.
model PrSeries {
  id         String    @id @default(cuid())
  exerciseId String
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// Denormalised so ownership checks never need a join.
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PrKind
  /// Always 1 for ONE_REP_MAX and REP.
  sets       Int       @default(1)
  /// Always 1 for ONE_REP_MAX.
  reps       Int       @default(1)
  createdAt  DateTime  @default(now())
  entries    PrEntry[]

  @@unique([exerciseId, kind, sets, reps])
  @@index([userId, exerciseId])
}

/// One dated record on a series.
///
/// Weight is stored canonically in kg — unlike `Profile.weight`, which keeps the unit
/// the user entered. A series is a comparison: the y-axis and the monotonicity check
/// both need one scale, and mixed units inside a series would silently corrupt both.
model PrEntry {
  id         String   @id @default(cuid())
  seriesId   String
  series     PrSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  achievedOn DateTime @db.Date
  /// The admin who logged this for the athlete; null when they logged it themselves.
  /// A loose reference, not a relation — the badge only needs to know that it happened.
  loggedById String?
  createdAt  DateTime @default(now())

  /// Two records on one day are two points, stacked on the same date — that is what a
  /// double-bodyweight morning looks like, and flattening it to one would hide half of it.
  /// `createdAt` breaks the tie, so a day's records keep the order they were logged in.
  @@index([seriesId, achievedOn, createdAt])
}
